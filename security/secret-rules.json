{
  "$comment": "Secret-scan rules (X05). Gate configuration is data in the repository: editing a ticket, an issue, or AGENTS.md text cannot change it. A leading (?i) in a pattern means case-insensitive.",
  "fileNames": [
    {
      "id": "env-file",
      "pattern": "(^|/)\\.env(\\.[^/]+)?$",
      "exceptions": ["\\.env\\.example$", "\\.env\\.sample$"]
    },
    { "id": "private-key-file", "pattern": "\\.(pem|key|pfx|p12|jks|keystore|ppk)$" },
    { "id": "ssh-private-key", "pattern": "(^|/)id_(rsa|dsa|ecdsa|ed25519)$" },
    {
      "id": "gemini-credentials",
      "pattern": "(^|/)\\.gemini/(oauth_creds|credentials|google_accounts)[^/]*$"
    },
    {
      "id": "antigravity-credentials",
      "pattern": "(^|/)(\\.antigravity|antigravity)/[^/]*(token|credential|cookie|session)[^/]*$"
    },
    { "id": "npmrc-with-auth", "pattern": "(^|/)\\.npmrc$" },
    { "id": "cookies-db", "pattern": "(^|/)(Cookies|cookies\\.sqlite|Login Data)$" }
  ],
  "content": [
    { "id": "aws-access-key", "pattern": "\\bAKIA[0-9A-Z]{16}\\b" },
    { "id": "github-token", "pattern": "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b" },
    { "id": "github-fine-grained-token", "pattern": "\\bgithub_pat_[A-Za-z0-9_]{50,}\\b" },
    { "id": "slack-token", "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b" },
    { "id": "google-api-key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    {
      "id": "private-key-block",
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY( BLOCK)?-----"
    },
    {
      "id": "bearer-token",
      "pattern": "(?i)\\bauthorization\\s*[:=]\\s*['\"]?bearer\\s+[A-Za-z0-9._~+/-]{20,}"
    },
    {
      "id": "generic-secret-assignment",
      "pattern": "(?i)\\b(api[_-]?key|secret|password|passwd|access[_-]?token|client[_-]?secret)\\b\\s*[:=]\\s*['\"][A-Za-z0-9/+_=.-]{20,}['\"]"
    }
  ]
}
