{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Vela builds your project from its issues, with Antigravity.",
    "externalBin": ["binaries/vela-hook"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Vela"
      }
    }
  }
}
